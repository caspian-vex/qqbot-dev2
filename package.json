{
  "name": "qqbot",
  "version": "0.3.7",
  "private": true,
  "description": "QQ 聊天机器人：OneBot 接入 + LLM 对话 + 自带面板（TypeScript 重写）",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "bump": "node scripts/bump.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.3.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
